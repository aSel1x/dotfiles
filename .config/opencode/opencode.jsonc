{
  "$schema": "https://opencode.ai/config.json",
  // «Мозги». Права: побеждает ПОСЛЕДНЕЕ совпавшее правило,
  // поэтому широкие "ask" идут первыми, точечные "allow" — после.
  // Правило хозяина: любая запись вне изолированного docker — спрашивать.
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "sed -n *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "pgrep *", "effect": "allow" },
    { "action": "shell", "resource": "ss *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "free *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "uptime *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "nvidia-smi *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl status *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl --user status *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl --user is-enabled *", "effect": "allow" },
    { "action": "shell", "resource": "systemctl --user is-active *", "effect": "allow" },
    { "action": "shell", "resource": "journalctl *", "effect": "allow" },
    { "action": "shell", "resource": "loginctl show *", "effect": "allow" },
    { "action": "shell", "resource": "dpkg -l *", "effect": "allow" },
    { "action": "shell", "resource": "dpkg -s *", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "browse_*", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  // MCP: figma — макеты (OAuth, первый вход через /mcps);
  // browse — агентский браузер (путь существует на домашней машине,
  // на чужой просто не запустится — не страшно).
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "browse": {
        "type": "local",
        "command": ["/home/asel1x/.local/bin/browse", "mcp"],
        "cwd": "/home/asel1x",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
