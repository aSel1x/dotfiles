{
  "$schema": "https://opencode.ai/config.json",
  // «Мозги». Правила поведения — в AGENTS.md.
  // Здесь только забор вокруг необратимого: удаление, root, установка,
  // наружу (push), винда. Всё остальное разрешено.
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "apt *", "effect": "ask" },
    { "action": "shell", "resource": "apt-get *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "wsl.exe *", "effect": "ask" },
    { "action": "shell", "resource": "/mnt/c/*", "effect": "ask" }
  ],
  // MCP: figma — макеты (OAuth, первый вход через /mcps);
  // browse — агентский браузер (путь существует на домашней машине,
  // на чужой просто не запустится — не страшно).
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "browse": {
        "type": "local",
        "command": ["/home/asel1x/.local/bin/browse", "mcp"],
        "cwd": "/home/asel1x",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
